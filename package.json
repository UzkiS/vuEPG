{
  "name": "vuepg",
  "version": "1.2.2",
  "description": "Vue2/3 通用大屏端焦点管理工具",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vue-demi-switch 3 && rimraf dist/ && tsc",
    "test": "pnpm test:3 && pnpm test:2",
    "test:2": "vue-demi-switch 2 vue2 && vitest run",
    "test:3": "vue-demi-switch 3 && vitest run",
    "check": "pnpm test && pnpm build",
    "publish:legacy": "pnpm check && npm publish --tag legacy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UzkiS/vuEPG.git"
  },
  "keywords": [
    "epg",
    "vuepg",
    "vue-epg",
    "focusable",
    "iptv"
  ],
  "author": "UzkiS",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/UzkiS/vuEPG/issues"
  },
  "homepage": "https://github.com/UzkiS/vuEPG#readme",
  "publishConfig": {
    "tag": "legacy"
  },
  "dependencies": {
    "vue-demi": "0.14.10"
  },
  "peerDependencies": {
    "@vue/composition-api": "^1.0.0-rc.1",
    "vue": "^2.0.0 || >=3.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "jsdom": "26.1.0",
    "rimraf": "5.0.10",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "vue": "3.5.43",
    "vue2": "npm:vue@2.7.16"
  }
}
